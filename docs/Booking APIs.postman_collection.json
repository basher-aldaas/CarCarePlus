            "body": {
              "mode": "raw",
              "raw": "{\n  \"car_ids\": [\n    \"{{car_id}}\"\n  ],\n  \"service_id\": \"{{service_id}}\",\n  \"branch_id\": \"{{branch_id}}\",\n  \"booking_type\": false,\n  \"scheduled_at\": \"2026-12-31 10:00:00\",\n  \"payment_method\": \"cash\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Step 1: prices the booking and returns a single-use `quote_token` (+ `expires_at`). Saves `quote_token` to a collection variable. Fill `car_id`, `service_id`, `branch_id`."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "if (res.data && res.data.quote_token) {",
                  "    pm.collectionVariables.set('quote_token', res.data.quote_token);",
                  "    console.log('Saved quote_token =', res.data.quote_token);",
                  "}"
                ]
              }
            }
          ]
